# Docker Compose v2. Run: python3 ops/setup.py init
COMPOSE_PROJECT_NAME=xiaomi-ai-hub
BRIDGE_IMAGE=xiaomi-ai-hub-bridge:local
HEALTH_IMAGE=xiaomi-ai-hub-health:local
PYTHON_IMAGE=python:3.11-slim-bookworm
PIP_INDEX_URL=https://pypi.org/simple
# Loopback is the safe default. Change deliberately for LAN access.
BIND_ADDRESS=127.0.0.1
PANEL_PORT=18765
HEALTH_PORT=8321
TZ=Asia/Shanghai
