# 统一按 LF 存储，避免 Windows 检出时把脚本改成 CRLF
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.woff binary
*.woff2 binary

# Preserve verbatim third-party license text, including upstream whitespace.
licenses/*.txt -whitespace
services/*/src/*/licenses/*.txt -whitespace
